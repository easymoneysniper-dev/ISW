# Copia este archivo como .env. El .env NO se sube a GitHub.
# Dirección de la API, incluyendo /api.
#   Local:    http://localhost:3000/api
#   Servidor: /api   (el backend entrega el frontend por el mismo puerto)
# Si lo cambias, vuelve a ejecutar "npm run build".
VITE_API_URL=http://localhost:3000/api
