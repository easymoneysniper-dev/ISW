// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoTransmision {
  COTIZADA
  ACEPTADA
  CONFIRMADA
  REALIZADA
  RENDIDA
  CERRADA
  RECHAZADA
  CANCELADA
}

model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(150)
  transmisiones Transmision[]
  creadoEn      DateTime      @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime      @updatedAt @db.Timestamptz(3)

  @@map("clientes")
}

model Transmision {
  id              Int               @id @default(autoincrement())
  nombreEvento    String            @db.VarChar(200)
  inicio          DateTime          @db.Timestamptz(3)
  termino         DateTime          @db.Timestamptz(3)
  lugar           String            @db.VarChar(250)
  cantidadCamaras Int
  precioCotizado  Decimal           @db.Decimal(14, 0)
  salidaRegiones  Boolean           @default(false)
  estado          EstadoTransmision @default(COTIZADA)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  creadoEn      DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)

  @@index([inicio])
  @@index([clienteId])
  @@map("transmisiones")
}

enum RolUsuario {
  DUENO
  CONTADOR
  JEFE_TECNICO
  ADMIN_DESARROLLO
}

model Usuario {
  id            Int        @id @default(autoincrement())
  nombre        String     @db.VarChar(150)
  email         String     @unique @db.VarChar(254)
  passwordHash  String     @db.VarChar(255)
  rol           RolUsuario
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime   @updatedAt @db.Timestamptz(3)

  @@map("usuarios")
}

model Trabajador {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(150)
  rut           String   @unique @db.VarChar(20)
  telefono      String?  @db.VarChar(30)
  email         String?  @unique @db.VarChar(254)
  roles         String[]
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)

  @@map("trabajadores")
}

model RegistroCambio {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  modulo    String   @db.VarChar(20)
  accion    String   @db.VarChar(50)
  entidad   String   @db.VarChar(100)
  entidadId Int?
  detalle   String?  @db.VarChar(500)
  creadoEn  DateTime @default(now()) @db.Timestamptz(3)

  @@index([creadoEn])
  @@map("registros_cambio")
}

enum EstadoEquipo {
  DISPONIBLE
  DANADO
  EN_REPARACION
  PERDIDO
  DADO_DE_BAJA
}

// Contenedor básico para RF 3.1. La composición y clasificación se amplían en RF 3.2.
model Kit {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(150)
  equipos       Equipo[]
  creadoEn      DateTime @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)

  @@map("kits")
}

model Equipo {
  id            Int          @id @default(autoincrement())
  nombre        String       @db.VarChar(150)
  marca         String?      @db.VarChar(100)
  modelo        String?      @db.VarChar(100)
  numeroSerie   String?      @unique @db.VarChar(150)
  precioCompra  Decimal      @db.Decimal(14, 0)
  fechaCompra   DateTime     @db.Date
  estado        EstadoEquipo @default(DISPONIBLE)
  kitId         Int?
  kit           Kit?         @relation(fields: [kitId], references: [id], onDelete: Restrict)
  creadoEn      DateTime     @default(now()) @db.Timestamptz(3)
  actualizadoEn DateTime     @updatedAt @db.Timestamptz(3)

  @@index([fechaCompra])
  @@index([kitId])
  @@map("equipos")
}
