# Copia este archivo como .env y completa tus datos. El .env NO se sube a GitHub.

# Conexión a PostgreSQL (la usa Prisma)
# Formato: postgresql://USUARIO:CLAVE@HOST:5432/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:tu_clave@localhost:5432/isw_db?schema=public"

# Puerto del backend (local: 3000 · servidor FACE: 80)
PORT=3000

# Dirección del frontend en desarrollo (para CORS)
FRONTEND_URL=http://localhost:5173

# Texto largo y aleatorio para firmar la cookie de sesión
SESSION_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# En el servidor: production (el backend entrega también el frontend compilado)
NODE_ENV=development

# Datos del primer usuario (npm run crear-usuario). Mínimo 12 caracteres.
ADMIN_NOMBRE=Nombre Apellido
ADMIN_EMAIL=dueno@correo.cl
ADMIN_PASSWORD=REEMPLAZA_ESTO
